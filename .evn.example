# Copy this file to .env and adjust values for your local setup
# docker-compose automatically picks up the .env file in the same directory

# Used by service-auth to sign JWTs. Change in production.
JWT_SECRET=local-dev-secret-please-change

# Postgres credentials for local dev (npm run dev outside Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
